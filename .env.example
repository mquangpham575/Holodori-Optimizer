# Backend
# Set DATABASE_URL to use PostgreSQL (prod). Omit it to use the JSON-file store.
# DATABASE_URL=postgres://user:pass@localhost:5432/holodreams
# Local Postgres (Docker) has no SSL — set PGSSL=false.
# PGSSL=false
PORT=5000

# Admin auth — the login password and the secret used to sign session tokens.
# Change both in any real deployment.
ADMIN_PASSWORD=admin123
ADMIN_SECRET=dev-admin-secret-change-me
# With DATABASE_URL set (production) the admin area stays DISABLED (503) unless
# both values are set and are not the defaults above.
# Number of reverse-proxy hops in front of the API, used for the login rate
# limiter's client IP (default: 1 in production, 0 locally).
# TRUST_PROXY=1
# Admin token lifetime in seconds (default 86400 = 24h)
# ADMIN_TOKEN_TTL=86400

# Kafka (optional). Leave unset to run without Kafka — the producer/consumer
# degrade gracefully.
# KAFKA_BROKERS=localhost:9092

# Logging level for pino (trace|debug|info|warn|error)
# LOG_LEVEL=info

# Override the JSON data store path (used by tests)
# DB_PATH=backend/database.json

# Full card illustrations are mirrored from this CDN into our own store (one download per
# card, revalidated weekly). Leave empty to disable and keep the bundled card art only.
# CARD_ART_CDN_BASE=https://cdn.holodori.dev

# Where card data comes from. auto (default): HolodoriDB master tables, falling back to the
# optimizer's bundled pack; master: master tables only; optimizer: optimizer pack only;
# none: no upstream sync at all (the catalog stays as it is in the database).
# HOLODORI_DATA_SOURCE=auto
# Point at a mirror of the master tables (https only, no trailing slash needed).
# HOLODORI_MASTER_BASE_URL=https://raw.githubusercontent.com/HolodoriDB/holodori-db-eng-diff/main
# Set to "false" to stop loading the bundled framed card art from the optimizer.
# CARD_ART_BUNDLE=true

# Frontend build-time (Vercel): host that 5-star card animations are streamed from.
# Set to an empty string to hide the Animation button.
# VITE_CARD_VIDEO_BASE=https://cdn.holodori.dev

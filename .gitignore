# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# HolodoriDB card art cache — regenerated by the holodori sync; prod serves from Postgres
frontend/public/images/cards/

# Playwright test output
playwright-report/
test-results/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# HolodoriDB ETL scratch files (regenerated by backend/src/etl/sync-holodori-db.ts)
backend/holodori_snapshot.json
backend/last_version.txt

# Per-device presets/rosters from the JSON dev store (never commit user data)
backend/*.user.json
frontend/public/images/upload_*

# Mirrored full-size card illustrations (regenerated by the sync; prod serves from Postgres)
frontend/public/images/cards-full/
frontend/public/images/cards-thumb/
frontend/public/images/cards-square/

# Card animation/signature videos mirrored on demand (prod serves them from Postgres)
frontend/public/images/cards-anim/
frontend/public/images/cards-sign/

{
  "name": "hololive-dream",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node backend/dist/server.js",
    "dev": "concurrently \"npm run dev:backend\" \"vite frontend\"",
    "dev:backend": "tsx backend/src/server.ts",
    "server": "node backend/dist/server.js",
    "client": "vite frontend",
    "build": "npm run build:backend && vite build frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "lint": "oxlint",
    "test": "tsx --test backend/tests/*.test.ts",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.28.0",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0"
  }
}
